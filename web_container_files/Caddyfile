{
    frankenphp {

        php_ini {
            memory_limit 256M
            max_execution_time 15
        }
    }
}

localhost {
	# Enable compression (optional)
	encode zstd br gzip

	root * /app/public

	route {
		# Keep maintenance scripts out of the web surface.
		@blockedPrivateDirs path /crons /crons/* /tools /tools/*
		respond @blockedPrivateDirs 404

		# Serve public files directly and send application routes to the front controller.
		try_files {path} /index.php

		# Execute PHP files in the current directory and serve assets
		php_server
	}
}
